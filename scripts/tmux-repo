#!/usr/bin/env bash
set -euo pipefail

# AI HERE: assumes repo at ~/nixos-config and flake attr == hostname; start() mirrors tmux-init.nix.
NIX="${TMUX_REPO_NIX:-$HOME/nixos-config/modules/tmux-init.nix}"
CONFIG="${NIX%/*/*}"
FILE="$NIX"
ORIG=""
PENDING=""
TMP=""
cleanup() { [ -z "$TMP" ] || rm -rf "$TMP"; }
trap cleanup EXIT

die() { printf 'tmux-repo: %s\n' "$*" >&2; exit 1; }

entries_of() { awk '/^[[:space:]]*create_session[[:space:]]/ { print $2 "\t" $3 }' "$1"; }
entries() { entries_of "$FILE"; }

write() {
    local tmp="$FILE.tmp.$$"
    cat >"$tmp"
    [ -s "$tmp" ] || { rm -f "$tmp"; die "empty write, $FILE untouched"; }
    chmod --reference="$FILE" "$tmp"
    mv "$tmp" "$FILE"
}

insert() {
    local name="$1" dir="$2" at
    at=$(awk '/^[[:space:]]*pi \// { last = NR } END { print last + 0 }' "$FILE")
    if [ "$at" -eq 0 ]; then
        at=$(awk "/^[[:space:]]*'';/ { print NR; exit }" "$FILE")
        at=$((at - 1))
    fi
    [ "$at" -gt 0 ] || die "no place in $FILE to add a session"
    awk -v at="$at" -v name="$name" -v dir="$dir" '
        { print }
        NR == at {
            printf "      create_session %s %s %s \\\n        commands %s \\\n        pi %s\n", name, dir, name, dir, dir
        }' "$FILE" | write
}

remove() {
    awk -v n="$1" '
        /^[[:space:]]*create_session[[:space:]]/ {
            if ($2 == n) { skip = 1; next }
            skip = 0
        }
        skip { if ($0 ~ /^[[:space:]]*pi /) skip = 0; next }
        { print }' "$FILE" | write
}

start() {
    local name="$1" dir="$2"
    tmux has-session -t "$name" 2>/dev/null && return 0
    tmux new-session -d -s "$name" -c "$dir" -n "$name"
    tmux new-window -t "$name:" -c "$dir" -n commands
    tmux new-window -t "$name:" -c "$dir" -n pi
}

rebuild() {
    sudo nixos-rebuild switch --flake "$CONFIG#$(hostname)" --show-trace
}

stage() {
    [ -n "$PENDING" ] && return 0
    if [ -n "$(git -C "$CONFIG" status --porcelain -- "$NIX")" ]; then
        printf 'uncommitted changes in %s, commit them first\n' "$NIX" >&2
        return 1
    fi
    TMP=$(mktemp -d)
    ORIG="$TMP/orig"
    FILE="$TMP/nix"
    cp "$NIX" "$ORIG"
    cp "$NIX" "$FILE"
    PENDING=1
}

unstage() {
    [ -z "$TMP" ] || rm -rf "$TMP"
    TMP=""
    ORIG=""
    FILE="$NIX"
    PENDING=""
}

added() { comm -13 <(entries_of "$ORIG" | cut -f1 | sort) <(entries | cut -f1 | sort); }
removed() { comm -23 <(entries_of "$ORIG" | cut -f1 | sort) <(entries | cut -f1 | sort); }

count_changes() {
    local n
    [ -n "$PENDING" ] || { printf '0'; return 0; }
    n=$(comm -3 <(entries_of "$ORIG" | cut -f1 | sort) <(entries | cut -f1 | sort) | wc -l)
    [ "$n" = 0 ] && ! cmp -s "$ORIG" "$FILE" && n=1
    printf '%s' "$n"
}

subject() {
    local a d p out="" parts=()
    a=$(added | paste -sd' ' -)
    d=$(removed | paste -sd' ' -)
    if [ -z "$a" ] && [ -z "$d" ]; then
        cmp -s "$ORIG" "$FILE" || printf 'chore(tmux): reorder repos'
        return 0
    fi
    [ -n "$a" ] && parts+=("add $a")
    [ -n "$d" ] && parts+=("remove $d")
    for p in "${parts[@]}"; do out="${out:+$out, }$p"; done
    printf 'chore(tmux): %s' "$out"
}

add() {
    local dir="${1:-}" name n
    if [ -z "$dir" ]; then printf 'no repo directory given\n' >&2; return 1; fi
    if [ ! -d "$dir" ]; then printf 'not a directory: %s\n' "$dir" >&2; return 1; fi
    dir=$(cd "$dir" && pwd)
    name=$(basename "$dir")
    case "$name$dir" in *[[:space:]]*) printf 'whitespace in repo path unsupported: %s\n' "$dir" >&2; return 1 ;; esac
    if entries | cut -f1 | grep -qxF -- "$name"; then
        printf 'already registered: %s\n' "$name" >&2
        return 1
    fi
    stage || return 1
    insert "$name" "$dir"
    n=$(entries | cut -f1 | grep -cxF -- "$name" || true)
    [ "$n" = 1 ] || { cp "$ORIG" "$FILE"; die "insert failed, staging reset"; }
    printf 'staged add %s\n' "$name"
}

delete() {
    local name="$1" n
    if ! entries | cut -f1 | grep -qxF -- "$name"; then
        printf 'not registered: %s\n' "$name" >&2
        return 1
    fi
    stage || return 1
    remove "$name"
    n=$(entries | cut -f1 | grep -cxF -- "$name" || true)
    [ "$n" = 0 ] || { cp "$ORIG" "$FILE"; die "remove failed, staging reset"; }
    printf 'staged remove %s\n' "$name"
}

enter() {
    local name="$1" dir
    dir=$(entries_of "$NIX" | awk -v n="$name" '$1 == n { print $2; exit }')
    if [ -z "$dir" ]; then
        printf 'staged only, apply first: %s\n' "$name" >&2
        return 1
    fi
    start "$name" "$dir"
    if [ -n "${TMUX:-}" ]; then
        tmux switch-client -t "$name"
    else
        tmux attach -d -t "$name"
    fi
}

block_bounds() {
    awk -v n="$1" '
        /^[[:space:]]*create_session[[:space:]]/ && $2 == n { s = NR; on = 1 }
        on && /^[[:space:]]*pi / { print s, NR; exit }
    ' "$FILE"
}

move() {
    local name="$1" delta="$2" a="" b="" c="" d="" i=-1 j k t
    local -a names
    mapfile -t names < <(entries | cut -f1)
    for ((k = 0; k < ${#names[@]}; k++)); do
        [ "${names[k]}" = "$name" ] && { i=$k; break; }
    done
    [ "$i" -ge 0 ] || { printf 'not registered: %s\n' "$name" >&2; return 1; }
    j=$((i + delta))
    if [ "$j" -lt 0 ]; then printf 'already first\n' >&2; return 0; fi
    if [ "$j" -ge "${#names[@]}" ]; then printf 'already last\n' >&2; return 0; fi
    stage || return 1
    read -r a b < <(block_bounds "$name") || die "block not found: $name"
    read -r c d < <(block_bounds "${names[j]}") || die "block not found: ${names[j]}"
    if [ "$a" -gt "$c" ]; then
        t=$a; a=$c; c=$t
        t=$b; b=$d; d=$t
    fi
    awk -v a="$a" -v b="$b" -v c="$c" -v d="$d" '
        { L[NR] = $0 }
        END {
            for (i = 1; i < a; i++) print L[i]
            for (i = c; i <= d; i++) print L[i]
            for (i = b + 1; i < c; i++) print L[i]
            for (i = a; i <= b; i++) print L[i]
            for (i = d + 1; i <= NR; i++) print L[i]
        }' "$FILE" | write
}

pick_repo() {
    local out dir
    out=$(find "$HOME" -mindepth 1 -maxdepth 2 -name .git -type d -printf '%h\n' 2>/dev/null |
        awk -F/ -v reg="$(entries | cut -f1 | tr '\n' ' ')" 'index(" " reg " ", " " $NF " ") { next } { print }' |
        sort -u | fzf --print-query --reverse --height=60% \
        --header='pick a repo, or type a path' --prompt='add> ') || return 1
    dir=$(printf '%s\n' "$out" | tail -1)
    [ -n "$dir" ] || return 1
    printf '%s\n' "$dir"
}

# AI HERE: amends only an unpushed tmux-scoped commit that touched just this file.
amendable() {
    local rel files
    [ -z "$(git -C "$CONFIG" branch -r --contains HEAD 2>/dev/null)" ] || return 1
    case "$(git -C "$CONFIG" log -1 --format=%s 2>/dev/null)" in
        chore\(tmux\):*|feat\(tmux\):*|fix\(tmux\):*|ref\(tmux\):*) ;;
        *) return 1 ;;
    esac
    rel="${NIX#"$CONFIG"/}"
    files=$(git -C "$CONFIG" diff-tree --no-commit-id --name-only -r --root HEAD 2>/dev/null)
    [ "$files" = "$rel" ]
}

apply() {
    local msg subj prev n dir cur="" before=""
    local -a cargs
    [ -n "$PENDING" ] || { printf 'nothing staged\n'; return 0; }
    if cmp -s "$ORIG" "$FILE"; then
        unstage
        printf 'no net changes\n'
        return 0
    fi
    subj=$(subject)
    if amendable; then
        prev=$(git -C "$CONFIG" log -1 --format=%s 2>/dev/null || true)
        subj="${prev}, ${subj#chore(tmux): }"
    fi
    read -r -e -i "$subj" -p 'commit msg> ' msg || return 1
    [ -n "$msg" ] || msg="$subj"

    cargs=(-q --only -m "$msg")
    amendable && cargs+=(--amend)
    before=$(git -C "$CONFIG" rev-parse HEAD 2>/dev/null || true)
    cp "$FILE" "$NIX"
    if ! git -C "$CONFIG" commit "${cargs[@]}" -- "$NIX"; then
        cp "$ORIG" "$NIX"
        unstage
        die "commit failed, edit reverted"
    fi
    if ! rebuild; then
        cp "$ORIG" "$NIX"
        if [ -n "$before" ]; then
            git -C "$CONFIG" reset -q --soft "$before"
            git -C "$CONFIG" reset -q HEAD -- "$NIX"
        fi
        unstage
        die "rebuild failed, commit and edit reverted"
    fi

    while read -r n; do
        [ -n "$n" ] || continue
        dir=$(entries | awk -v n="$n" '$1 == n { print $2; exit }')
        start "$n" "$dir" || printf 'warning: session %s not created\n' "$n" >&2
    done <<<"$(added)"

    [ -n "${TMUX:-}" ] && cur=$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null || true)
    while read -r n; do
        [ -n "$n" ] || continue
        if [ "$n" = "$cur" ]; then
            printf 'kept session %s (you are in it)\n' "$n"
            continue
        fi
        tmux has-session -t "$n" 2>/dev/null && tmux kill-session -t "$n"
    done <<<"$(removed)"

    unstage
    printf 'applied: %s\n' "$msg"
}

quit() {
    local act
    if [ -n "$PENDING" ] && [ "$(count_changes)" != 0 ]; then
        act=$(printf 'discard\napply\n' | fzf --reverse --height=30% \
            --header="$(count_changes) staged, apply now?" --prompt='> ') || act=""
        if [ "$act" = apply ]; then apply || true; fi
    fi
    exit 0
}

menu() {
    local out key choice dir row n
    while :; do
        n=$(count_changes)
        row="apply ($n change$([ "$n" = 1 ] || printf s))"
        out=$( {
            printf '+ add repo\n'
            if [ -n "$PENDING" ] && ! cmp -s "$ORIG" "$FILE"; then
                printf '%s\n' "$row"
            fi
            entries | cut -f1
        } | fzf --reverse --height=60% --expect=A,D,J,K \
            --header='enter attach | A add | D delete | K/J move | esc quit' \
            --prompt='repo> ') || quit
        key=$(printf '%s\n' "$out" | head -1)
        choice=$(printf '%s\n' "$out" | tail -n +2)

        case "$key" in
            A)
                dir=$(pick_repo) || continue
                add "$dir" || continue
                continue
                ;;
            D|J|K)
                if [ -n "$choice" ] && entries | cut -f1 | grep -qxF -- "$choice"; then
                    case "$key" in
                        D) delete "$choice" || true ;;
                        J) move "$choice" 1 || true ;;
                        K) move "$choice" -1 || true ;;
                    esac
                fi
                continue
                ;;
        esac

        [ -n "$choice" ] || quit
        if [ "$choice" = '+ add repo' ]; then
            dir=$(pick_repo) || continue
            add "$dir" || continue
            continue
        fi
        if [ -n "$PENDING" ] && [ "$choice" = "$row" ]; then
            apply || continue
            continue
        fi
        if enter "$choice"; then
            return 0
        fi
    done
}

if [ "${1:-}" = --self-test ]; then
    TMP=$(mktemp -d)
    ORIG="$TMP/orig"
    FILE="$TMP/nix"
    cp "$NIX" "$ORIG"
    cp "$NIX" "$FILE"
    PENDING=1
    insert selftest-repo /tmp/selftest
    grep -q '^      create_session selftest-repo /tmp/selftest selftest-repo \\$' "$FILE" ||
        die "self-test: insert produced no block"
    [ "$(entries | cut -f1 | grep -cxF selftest-repo)" = 1 ] ||
        die "self-test: insert not registered once"
    [ "$(subject)" = 'chore(tmux): add selftest-repo' ] ||
        die "self-test: subject wrong"
    remove selftest-repo
    cmp -s "$ORIG" "$FILE" || die "self-test: insert+remove did not round-trip"
    [ -z "$(subject)" ] || die "self-test: subject not empty after revert"
    mapfile -t order < <(entries | cut -f1)
    move "${order[1]}" -1
    [ "$(entries | cut -f1 | head -1)" = "${order[1]}" ] || die "self-test: move up failed"
    [ "$(subject)" = 'chore(tmux): reorder repos' ] || die "self-test: reorder subject wrong"
    [ "$(count_changes)" = 1 ] || die "self-test: reorder not counted"
    move "${order[1]}" 1
    cmp -s "$ORIG" "$FILE" || die "self-test: move did not round-trip"
    printf 'self-test ok\n'
    exit 0
fi

menu
